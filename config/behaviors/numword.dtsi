			tap-ms = <0>;
			bindings = <&kp UNDER>, <&to BASE>;
		};

		minusbase: minusbase {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&kp MINUS>, <&to BASE>;
		};

		sbase: sbase {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			/* bindings = <&kp S>, <&to BASE>, <&sl NEXUS>; */
			bindings = <&kp S>, <&to BASE>;
		};

		enterbase: enterbase {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&kp ENTER>, <&to BASE>;
		};


		tabbase: tabbase {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
