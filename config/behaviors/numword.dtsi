		/* 	compatible = "zmk,behavior-mod-morph"; */
		/* 	#binding-cells = <0>; */
		/* 	bindings = <&fnumwordp>, <&kp LS(C)>; */
		/* 	mods = <(MOD_LSFT|MOD_RSFT)>; */
		/* }; */

		spacebase: spacebase {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&kp SPACE>, <&to BASE>;
		};

