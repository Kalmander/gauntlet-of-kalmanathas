		/* nexus_sl: nexus_sl { */
		/* 	compatible = "zmk,behavior-macro"; */
		/* 	#binding-cells = <0>; */
		/* 	wait-ms = <0>; */
		/* 	tap-ms = <0>; */
		/* 	bindings = <&sl NEXUS>; */
		/* }; */

		bnexus: break_then_nexus {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&to NAV_WORD>, <&to BASE>, <&sl NEXUS>;
		};

		/* bsk_symbol_sk: bsk_symbol_sk { */
		/* 	compatible = "zmk,behavior-macro"; */
		/* 	#binding-cells = <0>; */
		/* 	wait-ms = <0>; */
		/* 	tap-ms = <0>; */
		/* 	bindings = <&to BASE>, <&sl SYMBOL>; */
		/* }; */


